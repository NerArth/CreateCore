# Generated by Cargo
# will have compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.suo
*.sw?

# Environment variables
.env
.env.*
!.env.example

# Profiling data
callgrind.out.*

# Modpack specific temporary/download folders
# Depending on how the binary runs locally during dev, we may want to ignore these
/mods/
/cache/
/downloads/